#!/bin/bash
#SBATCH --job-name=esc50-frozen
#SBATCH --time=10:00:00
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=96G
#SBATCH -o slurm_logs/%j_esc50-frozen.out
#SBATCH -e slurm_logs/%j_esc50-frozen.err

set -euo pipefail
source env.sh
CKPT="${CKPT:?set CKPT=/path/to/pretraining checkpoint}"
VIT="${VIT:-base}"
OUT="$OUTPUT_ROOT/esc50/frozen_${VIT}.json"

srun python ../esc50_probe.py \
  --checkpoint_path "$CKPT" \
  --vit_size "$VIT" \
  --esc50_root "$ESC50_ROOT" \
  --batch_size 32 \
  --num_workers 8 \
  --probe_lr 1e-3 \
  --probe_wd 1e-4 \
  --probe_epochs 100 \
  --probe_depth 4 \
  --probe_batch 128 \
  --num_seeds 3 \
  --out "$OUT"
