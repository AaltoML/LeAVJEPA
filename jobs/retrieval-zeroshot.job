#!/bin/bash
#SBATCH --job-name=retrieval-zeroshot
#SBATCH --time=04:00:00
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=128G
#SBATCH -o slurm_logs/%j_retrieval-zeroshot.out
#SBATCH -e slurm_logs/%j_retrieval-zeroshot.err

set -euo pipefail
source env.sh
CKPT="${CKPT:?set CKPT=/path/to/pretrain.ckpt}"
OUT="$OUTPUT_ROOT/retrieval/$(basename "$CKPT" .ckpt)"

srun python ../retrieval.py \
  --checkpoint_path "$CKPT" \
  --num_eval_clips 4 \
  --batch_size 32 \
  --num_workers 16 \
  --output_dir "$OUT"
